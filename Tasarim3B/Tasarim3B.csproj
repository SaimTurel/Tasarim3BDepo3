<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Tasarim3B</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  
  <ItemGroup>
    <None Remove="Resimler\Ac_16x16.png" />
    <None Remove="Resimler\Ac_32x32.png" />
    <None Remove="Resimler\Cerise.png" />
    <None Remove="Resimler\FarkliKaydet.png" />
    <None Remove="Resimler\FarkliKaydet_16x16.png" />
    <None Remove="Resimler\firma.png" />
    <None Remove="Resimler\Kaydet_16x16.png" />
    <None Remove="Resimler\TumKaydet_16x16.png" />
    <None Remove="Resimler\TumunuKaydet.png" />
    <None Remove="Resimler\Yeni_Doc_16x16.png" />
    <None Remove="Resimler\Yeni_Doc_32x32.png" />
    <None Remove="Tasarim.ico" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageReference Include="Fluent.Ribbon" Version="11.0.2" />
    <PackageReference Include="MahApps.Metro" Version="3.0.0-rc0529" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="6.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Tasarim3B.Core\Tasarim3B.Core.csproj" />
    <ProjectReference Include="..\Tasarim3B.Ortak\Tasarim3B.Ortak.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Resource Include="Resimler\Ac_16x16.png" />
    <Resource Include="Resimler\Ac_32x32.png" />
    <Resource Include="Resimler\Cerise.png" />
    <Resource Include="Resimler\FarkliKaydet.png" />
    <Resource Include="Resimler\FarkliKaydet_16x16.png" />
    <Resource Include="Resimler\firma.png" />
    <Resource Include="Resimler\Kaydet_16x16.png" />
    <Resource Include="Resimler\TumKaydet_16x16.png" />
    <Resource Include="Resimler\TumunuKaydet.png" />
    <Resource Include="Resimler\Yeni_Doc_16x16.png" />
    <Resource Include="Resimler\Yeni_Doc_32x32.png" />
    <Resource Include="Tasarim.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
